@page "/homep"
@using Energy.Models
@using Energy.Services
@using System.Net.Http.Json
@inject HttpClient Http
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JSRuntime
@implements IDisposable
@rendermode InteractiveServer
@inject EnergyService energyService

@code {
    private GridData? currentGrid;

    private string statusMessage = "OFF";
    private System.Threading.Timer? statusTimer;

    protected override async Task OnInitializedAsync()
    {
        currentGrid = await energyService.GetCurrentGridDataAsync();

        await FetchStatus();

        statusTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(FetchStatus);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private string GetColorForFuel(string fuelType)
    {
        return fuelType.ToLower() switch
        {
            "wind" => "#2ECC71",
            "solar" => "#F1C40F",
            "hydro" => "#3498DB",
            "nuclear" => "#9B59B6",
            "biomass" => "#E67E22",
            "gas" => "#E74C3C",
            "coal" => "#34495E",
            _ => "#95A5A6"
        };
    }

    private string GetDonutGradient()
    {
        if (currentGrid?.GenerationMix == null || !currentGrid.GenerationMix.Any())
            return "conic-gradient(#ccc 0% 100%)";

        var gradientParts = new List<string>();
        double currentAngle = 0;

        foreach (var fuel in currentGrid.GenerationMix.OrderByDescending(f => f.Perc))
        {
            if (fuel.Perc <= 0) continue;

            string color = GetColorForFuel(fuel.Fuel);
            double nextAngle = currentAngle + fuel.Perc;
            
            gradientParts.Add($"{color} {currentAngle}% {nextAngle}%");
            
            currentAngle = nextAngle;
        }

        return $"conic-gradient({string.Join(", ", gradientParts)})";
    }

    private async Task FetchStatus()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PiResponse>("http://192.168.0.13:5000/status");
            if (result != null)
            {
                statusMessage = result.state;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching status: {ex.Message}");
        }
    }

    public void Dispose()
    {
        statusTimer?.Dispose();
    }
}

