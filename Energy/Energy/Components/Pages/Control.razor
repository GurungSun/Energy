
@page "/control"
@using System.Net.Http.Json
@inject HttpClient Http
@using Energy.Models
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@implements IDisposable

@code {
    private string statusMessage = "OFF";

    private System.Threading.Timer? statusTimer;

    protected override async Task OnInitializedAsync()
    {
        await FetchStatus();

        statusTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(FetchStatus);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task FetchStatus()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PiResponse>("http://10.1.18.1:5000/status");
            if (result != null)
            {
                statusMessage = result.state;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching status: {ex.Message}");
        }
    }

    public void Dispose()
    {
        statusTimer?.Dispose();
    }

    private async Task SendFlashRequest()
    {
        statusMessage = "Sending command...";

        // 1. The URL (The Address of your Pi)
        string piUrl = "http://10.1.18.1:5000/flash";

        // 2. The Payload (The JSON 'Package' your teacher wants)
        // This creates: {"command": "start_flash"}
        var payload = new { command = "start_flash" };

        try
        {
            // 3. The POST Request
            // This sends the verb (POST), the address (piUrl), and the package (payload)
            var response = await Http.PostAsJsonAsync(piUrl, payload);

            if (response.IsSuccessStatusCode)
            {
                // This is where we handle the '200' code from the Pi
                statusMessage = "Success! LED is flashing.";
            }
            else
            {
                // This handles errors (like 400 or 404)
                statusMessage = $"Pi error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            // This handles network issues (like the Pi being turned off)
            statusMessage = "Error: Could not find the Pi on the network.";
            Console.WriteLine(ex.Message);
        }
    }

    private async Task ToggleLight()
    {
        var payload = new { command = "toggle" };

        try
        {
            var response = await Http.PostAsJsonAsync("http://10.1.18.1:5000/toggle", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PiResponse>();
                if (result != null)
                {
                    statusMessage = result.state;
                }
            }
            else
            {
                statusMessage = $"Pi error: {response.StatusCode}";
            }
        }

        catch (Exception ex)
        {

        }
    }
}

@inject HttpClient Http

