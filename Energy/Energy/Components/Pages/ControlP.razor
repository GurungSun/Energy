@page "/controlp"
@using System.Net.Http.Json
@inject HttpClient Http
@using Energy.Models
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@implements IDisposable

@code{
    private string statusMessage = "OFF";

    private System.Threading.Timer? statusTimer;

    protected override async Task OnInitializedAsync()
    {
        await FetchStatus();

        statusTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(FetchStatus);
        }, 

        null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

        private async Task FetchStatus()
        {
            try
            {
                var result = await Http.GetFromJsonAsync<PiResponse>("http://192.168.0.13:5000/status");
                if (result != null)
                {
                    statusMessage = result.state;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching status: {ex.Message}");
            }
        }

    public void Dispose()
    {
        statusTimer?.Dispose();
    }

    private async Task ToggleLight()
    {
        var payload = new { command = "toggle" };

        try
        {
            var response = await Http.PostAsJsonAsync("http://192.168.0.13:5000/toggle", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PiResponse>();
                if (result != null)
                {
                    statusMessage = result.state;
                }
            }
            else
            {
                statusMessage = $"Pi error: {response.StatusCode}";
            }
        }

        catch (Exception ex)
        {

        }
    }
}

